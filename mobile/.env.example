# Kobciye — environment setup (copy to mobile/.env and fill in)
# Values come from your Supabase project: Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public landing "Diiwaan geli Dugsigaaga" WhatsApp enquiry number.
# DIGITS ONLY: country code + number (NO '+', spaces or dashes).
# Example: Somaliland 252 + 63 7373367 => 252637373367. Public, not a secret.
EXPO_PUBLIC_LANDING_WHATSAPP_NUMBER=252637373367
