{
  "expo": {
    "name": "Kobciye",
    "slug": "kobciye-mobile",
    "version": "1.0.0",
    "scheme": "kobciye",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2E6B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kobciye.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A2E6B"
      },
      "package": "com.kobciye.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
