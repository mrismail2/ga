# ============================================================
# Kobciye — Edge Function secrets (PLACEHOLDERS ONLY — never commit real values)
#
# These are SERVER-SIDE secrets. They live only in the Edge Function runtime.
# NONE of them may ever appear in the mobile app, in mobile/.env, in
# EXPO_PUBLIC_* variables, in logs, or in build artifacts.
#
# Set them for your deployed project with:
#   supabase secrets set --env-file supabase/functions/.env
# (copy this file to supabase/functions/.env, fill in real values, and keep it
#  out of git — it is covered by .gitignore).
# ============================================================

# --- Provided automatically by the Supabase platform to every Edge Function ---
# You normally do NOT set these yourself; they are injected at runtime. Listed
# here only so the names are documented. NEVER hard-code the service role key.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # server-only, secret

# --- Custom secrets you DO set ---
# Where the invite / password-set / recovery email links redirect back to.
# Use the deployed web URL in production, or the mobile deep link.
KOBCIYE_INVITE_REDIRECT_URL=https://your-web-app.example.com/set-password

# Comma-separated browser origins allowed to call the functions (CORS).
# Include your Expo web origin(s). Native apps send no Origin and are unaffected.
KOBCIYE_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,https://your-web-app.example.com
